# Meta WhatsApp Cloud API (official first-party provider).
# Keep real credentials in an ignored local .env file or your deployment's
# secret manager. The verify token is a random value you choose and enter in
# both this file and Meta's webhook configuration.
PUBLIC_BASE_URL=https://your-public-https-host.example
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# These are different IDs. META_WABA_ID is the WhatsApp Business Account ID,
# not the Business Portfolio/Business Manager ID. META_PHONE_NUMBER_ID is shown
# beside the registered or test sender in WhatsApp > API Setup.
META_WABA_ID=
META_PHONE_NUMBER_ID=

# Pin the version shown in your Meta API Setup examples. Do not use "latest".
META_GRAPH_API_VERSION=v23.0

# StepFun vision (supplier invoice photo -> purchase draft). Server-side only;
# leave STEPFUN_API_KEY empty to keep POST /v1/intake/image disabled. The
# service never invents a number: anything the photo does not clearly show
# stays empty and waits for the owner to type it in.
STEPFUN_API_KEY=
# step-1o-turbo-vision is the vision model available to this account;
# step-5-preview and step-3.7-flash also accept images. "step-1v" is retired
# and returns HTTP 404.
STEPFUN_VISION_MODEL=step-1o-turbo-vision
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# Supabase PostgreSQL cloud data path (service/supabase_db.py).
# Server-side only: the service-role key bypasses row level security, so keep
# it out of browser code, logs, and version control (.env is git-ignored).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Opt-in cloud mirror: set to 1 so each approved purchase is also upserted to
# Supabase (SQLite stays the authority; failures only add an audit event).
# SUPABASE_MIRROR=1

# Optional: only needed if the dashboard later queries Supabase directly from
# the browser. Safe to expose publicly, but our migrations grant the anon key
# nothing (RLS deny-by-default), so the current server does not use it.
# SUPABASE_ANON_KEY=your-anon-key
