# Optional: only needed for a supported live Twilio WhatsApp webhook.
# Keep real credentials in an ignored local environment file or secret manager.
# The Trial REST poller deliberately does not read this file; set
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_WHATSAPP_TO in its process
# environment as documented in docs/TWILIO.md.
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=https://your-public-https-host.example
