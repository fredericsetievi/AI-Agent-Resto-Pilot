# Meta WhatsApp Cloud API (official first-party provider).
# Keep real credentials in an ignored local .env file or your deployment's
# secret manager. The verify token is a random value you choose and enter in
# both this file and Meta's webhook configuration.
PUBLIC_BASE_URL=https://your-public-https-host.example
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# These are different IDs. META_WABA_ID is the WhatsApp Business Account ID,
# not the Business Portfolio/Business Manager ID. META_PHONE_NUMBER_ID is shown
# beside the registered or test sender in WhatsApp > API Setup.
META_WABA_ID=
META_PHONE_NUMBER_ID=

# Pin the version shown in your Meta API Setup examples. Do not use "latest".
META_GRAPH_API_VERSION=v23.0

# StepFun vision (supplier invoice photo -> purchase draft). Server-side only;
# leave STEPFUN_API_KEY empty to keep POST /v1/intake/image disabled. The
# service never invents a number: anything the photo does not clearly show
# stays empty and waits for the owner to type it in.
STEPFUN_API_KEY=
# step-1o-turbo-vision is the vision model available to this account;
# step-5-preview and step-3.7-flash also accept images. "step-1v" is retired
# and returns HTTP 404.
STEPFUN_VISION_MODEL=step-1o-turbo-vision
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# StepFun speech, sharing the same STEPFUN_API_KEY and base URL as vision.
# ASR transcribes inbound WhatsApp voice notes into the normal text draft flow;
# TTS turns the "ringkas" weekly summary into a voice reply. Both are disabled
# with an empty STEPFUN_API_KEY: voice notes then get the safe text reply and
# "ringkas" answers with the text summary only.
STEPFUN_ASR_MODEL=step-asr-1.1
STEPFUN_TTS_MODEL=step-tts-2
# TTS voice for the weekly summary reply ("linjiameimei" is the voice verified
# on this account).
STEPFUN_TTS_VOICE=linjiameimei

# StepFun text rescue, sharing the same STEPFUN_API_KEY and STEPFUN_BASE_URL
# as vision. The deterministic rules parser always runs first and never
# changes; with LLM_TEXT_EXTRACTION=1 the model is only asked when the parser
# leaves warnings (free-form sentences like "tolong catat beli 150 ribu cabai
# 3kg nih", voice-note transcripts, split clauses). Any model error keeps the
# rules result, and command words ("ya", "batal", "ringkas") never reach the
# model.
# LLM_TEXT_EXTRACTION=1
# step-3.7-flash is a fast text model on this account; step-5-preview also
# works. The vision model is not used for text.
# STEPFUN_TEXT_MODEL=step-3.7-flash

# Supabase PostgreSQL cloud data path (service/supabase_db.py).
# Server-side only: the service-role key bypasses row level security, so keep
# it out of browser code, logs, and version control (.env is git-ignored).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Opt-in cloud mirror: set to 1 so each approved purchase is also upserted to
# Supabase (SQLite stays the authority; failures only add an audit event).
# SUPABASE_MIRROR=1

# Optional: only needed if the dashboard later queries Supabase directly from
# the browser. Safe to expose publicly, but our migrations grant the anon key
# nothing (RLS deny-by-default), so the current server does not use it.
# SUPABASE_ANON_KEY=your-anon-key

# Voice note ASR provider (speech-to-text for inbound WhatsApp voice notes).
# Optional: without these, ASR shares the StepFun account above, which only
# recognizes Chinese and English. To transcribe Indonesian voice notes, point
# this at a multilingual provider with an OpenAI-compatible multipart
# /audio/transcriptions endpoint. The base URL must be HTTPS without
# credentials, query, or fragment. The model name is case-sensitive.
# AUDIO_ASR_BASE_URL=https://llmapi.paratera.com/v1
# AUDIO_ASR_API_KEY=
# AUDIO_ASR_MODEL=GLM-ASR-2512

# Stock question answers: "berapa stok cabai?" is always answered from the
# SQLite inventory ledger — the model never invents a number. With
# LLM_STOCK_ANSWER=1 (and STEPFUN_API_KEY) the model only rephrases the same
# facts into one natural sentence; any model problem keeps the deterministic
# reply. The flag is optional: without it the deterministic reply is used.
# LLM_STOCK_ANSWER=1

# Static ngrok domain for the Meta WhatsApp webhook tunnel (see docs/TUNNEL.md).
# Claim one free at https://dashboard.ngrok.com/domains, then uncomment:
# NGROK_STATIC_DOMAIN=your-name.ngrok-free.dev
