# Meta WhatsApp Cloud API (official first-party provider).
# Keep real credentials in an ignored local .env file or your deployment's
# secret manager. The verify token is a random value you choose and enter in
# both this file and Meta's webhook configuration.
PUBLIC_BASE_URL=https://your-public-https-host.example
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# These are different IDs. META_WABA_ID is the WhatsApp Business Account ID,
# not the Business Portfolio/Business Manager ID. META_PHONE_NUMBER_ID is shown
# beside the registered or test sender in WhatsApp > API Setup.
META_WABA_ID=
META_PHONE_NUMBER_ID=

# Pin the version shown in your Meta API Setup examples. Do not use "latest".
META_GRAPH_API_VERSION=v23.0
